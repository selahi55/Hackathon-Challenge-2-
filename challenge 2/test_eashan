        st.caption("These are adjustable heuristics, not calibrated weather parameters.")
    if "prepared_db" not in st.session_state:
        st.info("Enter your paths in the sidebar and press **Prepare data**. For a first run, consider choosing a limited date range.")
        st.markdown("**What you can explore:** sensor clusters, eight compass regions (plus inside where appropriate), a time slider, maps, timelines and candidate scores.")
        st.stop()
    db = st.session_state["prepared_db"]
    st.caption("Prepared inputs: " + st.session_state["prepared_description"] + ". Changes to file/date/shift settings require pressing Prepare data again.")
    if extra_far <= extra_near:
        st.warning("The farthest exterior distance must be larger than the nearest.")
        st.stop()
    pmin, pmax, wmin, wmax, sensors, stations = database_info(db)
    st.write(f"**PM:** {hour_text(pmin)} → {hour_text(pmax)}  |  **Valid wind:** {hour_text(wmin)} → {hour_text(wmax)}")
    if None in (pmin, pmax, wmin, wmax) or sensors.empty or stations.empty:
        st.error("No usable PM data, wind direction or station locations. Check your date selection and columns.")
        st.stop()
    if max(pmin, wmin) > min(pmax, wmax):
        st.error("These PM and wind date ranges do not overlap. No real-wind analysis can be performed.")
        st.stop()
    st.info("Date ranges overlap; check the coverage table for actual sensor–station hour matches. No synthetic wind is used.")
    lat0, lon0 = float(sensors.lat.mean()), float(sensors.lon.mean())
    coords, station_coords = xy(sensors.lat, sensors.lon, lat0, lon0), xy(stations.lat, stations.lon, lat0, lon0)
    dist, nearest = cKDTree(station_coords).query(coords)
    groups = cluster_indices(coords, link, 3)
    if not groups:
        st.warning("No group has at least three sensors at this neighbour distance. Try changing the cluster setting.")
        st.stop()
    options = list(range(len(groups)))
    selected = st.selectbox("Sensor cluster", options, format_func=lambda i: f"Cluster {i + 1} — {len(groups[i])} sensors")
    inds = groups[selected]
    cand, has_inside = generate_candidates(coords[inds], extra_near, extra_far)
    records = tuple((str(sensors.iloc[i].sensor), str(stations.iloc[int(nearest[i])].station), float(dist[i]), float(sensors.iloc[i].lat), float(sensors.iloc[i].lon), float(coords[i, 0]), float(coords[i, 1])) for i in inds)
    with st.spinner("Loading selected cluster and calculating sensor baselines …"):
        data, coverage, count = load_cluster(db, records, spike_q, max_station)
    if data is None:
        st.error(f"This cluster has {count:,} sensor-hours; the display limit is {MAX_SENSOR_HOURS:,}. Restrict the date range and prepare the data again.")
        st.stop()
    if data.empty:
        st.warning("No PM observations for this cluster.")
        st.stop()
    with st.spinner("Comparing regional hypotheses …"):
        candidate_scores, region_scores = score_hypotheses(data, cand, width0, growth, 30, 10.0)
    valid = region_scores.dropna(subset=["score"])
    metrics = st.columns(4)
    metrics[0].metric("Sensors", len(inds))
    metrics[1].metric("PM sensor-hours", f"{len(data):,}")
    metrics[2].metric("Matched wind hours", f"{data.direction.notna().sum():,}")
    metrics[3].metric("Inside tested", "Yes" if has_inside else "No")
    if len(valid) >= 2 and valid.iloc[0].score >= 0.03 and valid.iloc[0].score - valid.iloc[1].score >= 0.01:
        st.info(f"Exploratory leading region: **{valid.iloc[0].region}**. This is not proof or a probability of a source.")
    else:
        st.warning("No clear direction under the current coverage and practical score thresholds.")
    tabs = st.tabs(["🗺️ Map & time", "📈 Sensor timelines", "🧭 Region comparison", "🔍 Coverage & assumptions"])
    with tabs[0]:
        st.subheader("Explore a region and a moment")
        a, b, c = st.columns([1, 1, 1])
        region_list = [r for r, _ in REGIONS] + (["inside"] if has_inside else [])
        region = a.selectbox("Hypothesis region", region_list)
        points = candidate_scores[candidate_scores.region == region].reset_index(drop=True)
        point = b.selectbox("Representative point", list(range(len(points))), format_func=lambda i: f"Point {int(points.iloc[i].point)}")
        source = points.iloc[point]
        street = c.selectbox("Map style", ["Street map (internet required)", "Coordinate plot (offline)"]).startswith("Street")
        hours = np.sort(data.hour.unique())
        k = st.slider("Time step", 0, len(hours) - 1, 0) if len(hours) > 1 else 0
        st.caption(f"**{hour_text(hours[k])}** — move the slider to inspect another hour. Map colours use the selected cluster's 95th PM percentile as the upper display limit, not health thresholds.")
        snapshot = data[data.hour == hours[k]].copy()
        vmax = max(float(data.pm.quantile(.95)), 0.01)
        fig, snapshot = build_map(snapshot, points, region, source, lat0, lon0, width0, growth, vmax, street)
        st.plotly_chart(fig, use_container_width=True)
        st.caption("Blue → red: lower → higher PM. Purple points: candidates; black: selected point. Green lines point from each sensor toward the wind tip. The purple plume is an illustration using the mean wind across visible sensors; scoring uses each sensor's own wind. Candidate points are hypothetical, not detected sources.")
        st.dataframe(snapshot[["sensor", "pm", "spike", "station", "direction", "fh_raw", "compatibility"]].rename(columns={"direction": "wind FROM (degrees)", "fh_raw": "FH raw; units unconfirmed"}), use_container_width=True, hide_index=True)
        with st.expander("▶ Animate PM across time"):
            nframes = st.slider("Number of hourly frames", 2, 100, min(24, max(2, len(hours))), disabled=len(hours) < 2)
            chosen = hours[k:k + nframes]
            if len(chosen) < 2:
                st.caption("Move the time slider earlier to view an animation.")
            else:
                anim = data[data.hour.isin(chosen)].copy()
                anim["frame"] = anim.time.dt.strftime("%Y-%m-%d %H:%M UTC")
                ani = px.scatter(anim, x="lon", y="lat", animation_frame="frame", animation_group="sensor", color="pm", hover_name="sensor", hover_data=["spike", "direction"], color_continuous_scale=PALETTE, range_color=[0, vmax], labels={"lon": "Longitude", "lat": "Latitude", "pm": "PM2.5"})
                ani.update_layout(height=500, xaxis=dict(scaleanchor="y", scaleratio=np.cos(np.deg2rad(lat0))))
                st.plotly_chart(ani, use_container_width=True)
                st.caption("Use Play/Pause and the animation slider. This coordinate plot shows PM only; it is not a plume simulation.")
    with tabs[1]:
        st.subheader("Sensor PM and wind over time")
        sensor = st.selectbox("Choose a sensor", sorted(data.sensor.unique()))
        sd = data[data.sensor == sensor].sort_values("hour")
        threshold = float(coverage.loc[coverage.sensor == sensor, "spike threshold"].iloc[0])
        fig = go.Figure()
        fig.add_trace(go.Scatter(x=sd.time, y=sd.pm, mode="lines", name="Hourly PM2.5", line=dict(color="#2563eb")))
        spikes = sd[sd.spike]
        fig.add_trace(go.Scatter(x=spikes.time, y=spikes.pm, mode="markers", name="Spikes", marker=dict(color="#dc2626", size=6)))
        fig.add_hline(y=threshold, line_dash="dash", line_color="#f97316", annotation_text=f"{int(spike_q * 100)}th percentile")
        fig.update_layout(height=360, margin=dict(l=10, r=10, t=10, b=10), yaxis_title="PM2.5", legend=dict(orientation="h"))
        st.plotly_chart(fig, use_container_width=True)
        wd = go.Figure(go.Scatter(x=sd.time, y=sd.direction, mode="markers", marker=dict(size=5, color=np.where(sd.spike, "#dc2626", "#14b8a6")), text=sd.station, hovertemplate="%{x}<br>Wind FROM: %{y:.0f}°<br>Station: %{text}<extra></extra>"))
        wd.update_layout(height=260, margin=dict(l=10, r=10, t=10, b=10), yaxis_title="Wind FROM (degrees)", yaxis=dict(range=[0, 360], tickvals=[0, 90, 180, 270, 360], ticktext=["N", "E", "S", "W", "N"]))
        st.plotly_chart(wd, use_container_width=True)
        st.caption("Red points on the wind chart coincide with PM spikes. Missing directions are not plotted.")
    with tabs[2]:
        st.subheader("Compare the regions")
        st.caption("Score = average across sensors of (spike rate when more compatible − spike rate when less compatible), then averaged across tested points. It is not a source probability.")
        good = region_scores.dropna(subset=["score"])
        if not good.empty:
            fig = px.bar(good, x="region", y="score", color="score", color_continuous_scale="RdBu_r", color_continuous_midpoint=0, hover_data=["scored points", "tested points", "min sensors"])
            fig.update_layout(height=400, margin=dict(l=10, r=10, t=10, b=10))
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.warning("Not enough matched wind and spike coverage to score the regions.")
        st.dataframe(region_scores, use_container_width=True, hide_index=True)
        st.download_button("Export regional scores as CSV", region_scores.to_csv(index=False), "region_scores.csv", "text/csv")
        st.dataframe(candidate_scores, use_container_width=True, hide_index=True)
    with tabs[3]:
        st.subheader("Data coverage")
        st.dataframe(coverage, use_container_width=True, hide_index=True)
        st.download_button("Export coverage as CSV", coverage.to_csv(index=False), "sensor_coverage.csv", "text/csv")
        st.markdown("""### Read before interpreting
- PM spikes are sensor-specific values strictly above the selected percentile; observations are hourly averages.
- DD is assumed to use standard KNMI **wind-from** coding: 0 calm, 990 variable and 360 north. FH is shown raw if present but is not used: verify its units in the processed file.
- Naive timestamps are assumed UTC; the wind-hour shift is an explicit setting. Verify both for your files.
- Each sensor uses the nearest station with valid direction data. Missing station hours are not replaced. Wind may differ between station and sensor.
- Inside uses an approximate convex-envelope heuristic; it is not a real known boundary. Sparse or linear groups do not get an inside category, which does not rule out nearby sources.
- Test points cover only a sample of each region. Plume width, grouping and thresholds are assumptions; change them to see whether conclusions are stable.
- Compatibility represents a widening downwind footprint, not predicted concentration. Speed, travel time, vertical mixing, terrain, background and multiple sources are not modelled.
- Sensor-hours are not independent episodes; scores are not statistical confidence or causal proof. Wind and PM can co-vary for reasons other than the hypothesised source.
""")


