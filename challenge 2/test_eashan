def to_time(series):
    kw = {"errors": "coerce", "utc": True}
    if int(pd.__version__.split(".")[0]) >= 2:
        kw["format"] = "mixed"
    return pd.to_datetime(series, **kw)


def clean_batch(batch, time_col, numeric, shift, start, end):
    df = batch.to_pandas()
    df[time_col] = to_time(df[time_col]).astype("datetime64[ns, UTC]")
    for col in numeric:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    df = df.dropna(subset=[time_col] + numeric).copy()
    for col in numeric:
        df = df[np.isfinite(df[col])]
    if df.empty:
        return df
    df["hour"] = (df[time_col].astype("int64") // 3_600_000_000_000 + shift).astype("int64")
    if start is not None:
        df = df[df.hour >= start]
    if end is not None:
        df = df[df.hour < end]
    return df


def file_fingerprint(pm_path, wind_path, start, end, shift):
    details = []
    for name in (pm_path, wind_path):
        p = Path(name).expanduser()
        if not p.is_file():
            raise FileNotFoundError(f"Cannot find file: {p}")
        s = p.stat()
        details.append((str(p.resolve()), s.st_size, s.st_mtime_ns))
    text = json.dumps([details, start, end, shift, "app-v1"])
    return hashlib.sha256(text.encode()).hexdigest()[:16]


def require_columns(pf, columns, label):
    available = set(pf.schema_arrow.names)
    missing = [x for x in columns if x not in available]
    if missing:
        raise ValueError(f"{label} is missing columns {missing}. Available: {sorted(available)}")


def build_database(pm_path, wind_path, start, end, shift, progress):
    fingerprint = file_fingerprint(pm_path, wind_path, start, end, shift)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    dest = CACHE_DIR / f"air_{fingerprint}.sqlite"
    if dest.exists():
        return str(dest), True
    pm = pq.ParquetFile(pm_path)
    wind = pq.ParquetFile(wind_path)
    require_columns(pm, PM_COLUMNS, "PM file")
    require_columns(wind, WIND_COLUMNS, "Wind file")
    has_fh = "FH" in wind.schema_arrow.names
    tmp = CACHE_DIR / f"air_{fingerprint}.working.sqlite"
    if tmp.exists():
        tmp.unlink()
    con = sqlite3.connect(str(tmp))
    try:
        con.executescript("""
          PRAGMA journal_mode=DELETE; PRAGMA synchronous=NORMAL;
          CREATE TABLE pm(sensor TEXT,hour INTEGER,total REAL,n INTEGER,PRIMARY KEY(sensor,hour));
          CREATE TABLE sensor_location(sensor TEXT PRIMARY KEY,lat_sum REAL,lon_sum REAL,n INTEGER);
          CREATE TABLE wind(station TEXT,hour INTEGER,ss REAL,cc REAL,n INTEGER,fs REAL,fn INTEGER,
                            PRIMARY KEY(station,hour));
          CREATE TABLE station_location(station TEXT PRIMARY KEY,lat_sum REAL,lon_sum REAL,n INTEGER);
        """)
        seen = 0
        for batch in pm.iter_batches(batch_size=BATCH_SIZE, columns=PM_COLUMNS):
            seen += batch.num_rows
            d = clean_batch(batch, "timestamp_from", ["pm25_raw", "latitude", "longitude"], 0, start, end)
            if not d.empty:
                d = d[d.kit_id.notna() & (d.pm25_raw >= 0) & d.latitude.between(-90, 90) & d.longitude.between(-180, 180)].copy()
                d["sensor"] = d.kit_id.astype(str)
                d = d[d.sensor.str.strip() != ""]
                if not d.empty:
                    h = d.groupby(["sensor", "hour"], sort=False).pm25_raw.agg(["sum", "count"]).reset_index()
                    loc = d.groupby("sensor", sort=False).agg(lat_sum=("latitude", "sum"), lon_sum=("longitude", "sum"), n=("latitude", "size")).reset_index()
                    con.executemany("INSERT INTO pm VALUES(?,?,?,?) ON CONFLICT(sensor,hour) DO UPDATE SET total=total+excluded.total,n=n+excluded.n",
                        [(str(s), int(t), float(v), int(n)) for s, t, v, n in h.itertuples(index=False, name=None)])
                    con.executemany("INSERT INTO sensor_location VALUES(?,?,?,?) ON CONFLICT(sensor) DO UPDATE SET lat_sum=lat_sum+excluded.lat_sum,lon_sum=lon_sum+excluded.lon_sum,n=n+excluded.n",
                        [(str(s), float(a), float(b), int(n)) for s, a, b, n in loc.itertuples(index=False, name=None)])
                    con.commit()
            progress.progress(min(0.49, 0.49 * seen / max(1, pm.metadata.num_rows)), text=f"Reading PM: {seen:,} rows")
        seen = 0
        cols = WIND_COLUMNS + (["FH"] if has_fh else [])
        for batch in wind.iter_batches(batch_size=BATCH_SIZE, columns=cols):
            seen += batch.num_rows
            d = clean_batch(batch, "time", ["lat", "lon", "DD"], shift, start, end)
            if not d.empty:
                d = d[d.station.notna() & d.DD.between(1, 360) & d.lat.between(-90, 90) & d.lon.between(-180, 180)].copy()
                d["station_id"] = d.station.astype(str)
                d = d[d.station_id.str.strip() != ""]
                if not d.empty:
                    a = np.deg2rad(d.DD.to_numpy())
                    d["ss"], d["cc"] = np.sin(a), np.cos(a)
                    d["fh_num"] = pd.to_numeric(d["FH"], errors="coerce") if has_fh else np.nan
                    d.loc[~np.isfinite(d.fh_num), "fh_num"] = np.nan
                    h = d.groupby(["station_id", "hour"], sort=False).agg(ss=("ss", "sum"), cc=("cc", "sum"), n=("DD", "size"), fs=("fh_num", "sum"), fn=("fh_num", "count")).reset_index()
                    loc = d.groupby("station_id", sort=False).agg(lat_sum=("lat", "sum"), lon_sum=("lon", "sum"), n=("DD", "size")).reset_index()
                    con.executemany("INSERT INTO wind VALUES(?,?,?,?,?,?,?) ON CONFLICT(station,hour) DO UPDATE SET ss=ss+excluded.ss,cc=cc+excluded.cc,n=n+excluded.n,fs=fs+excluded.fs,fn=fn+excluded.fn",
                        [(str(s), int(t), float(a), float(b), int(n), float(f), int(k)) for s, t, a, b, n, f, k in h.itertuples(index=False, name=None)])
                    con.executemany("INSERT INTO station_location VALUES(?,?,?,?) ON CONFLICT(station) DO UPDATE SET lat_sum=lat_sum+excluded.lat_sum,lon_sum=lon_sum+excluded.lon_sum,n=n+excluded.n",
                        [(str(s), float(a), float(b), int(n)) for s, a, b, n in loc.itertuples(index=False, name=None)])
                    con.commit()
            progress.progress(min(0.99, 0.49 + 0.5 * seen / max(1, wind.metadata.num_rows)), text=f"Reading wind: {seen:,} rows")
        con.close()
        os.replace(tmp, dest)
        progress.progress(1.0, text="Data prepared")
        return str(dest), False
    except Exception:
        con.close()
        if tmp.exists():
            tmp.unlink()
        raise


@st.cache_data(show_spinner=False)
