def xy(lat, lon, lat0, lon0):
    return np.column_stack(((np.asarray(lon) - lon0) * 111.32 * np.cos(np.deg2rad(lat0)), (np.asarray(lat) - lat0) * 111.32))


def lonlat(points, lat0, lon0):
    return lon0 + points[:, 0] / (111.32 * np.cos(np.deg2rad(lat0))), lat0 + points[:, 1] / 111.32


def cluster_indices(coords, link, min_size):
    parent = list(range(len(coords)))
    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i
    for i, j in cKDTree(coords).query_pairs(link):
        a, b = find(i), find(j)
        if a != b:
            parent[b] = a
    groups = {}
    for i in range(len(coords)):
        groups.setdefault(find(i), []).append(i)
    return sorted([g for g in groups.values() if len(g) >= min_size], key=len, reverse=True)


def generate_candidates(coords, extra_near, extra_far):
    center = coords.mean(axis=0)
    radius = float(np.max(np.linalg.norm(coords - center, axis=1)))
    rows = []
    for region, angle in REGIONS:
        for offset in (-15, 0, 15):
            for extra in (extra_near, extra_far):
                a = np.deg2rad(angle + offset)
                p = center + (radius + extra) * np.array([np.sin(a), np.cos(a)])
                rows.append((region, float(p[0]), float(p[1])))
    inside = False
    if len(coords) >= 8:
        eig = np.linalg.eigvalsh(np.cov(coords.T))
        ratio = np.sqrt(max(0, eig[0]) / eig[1]) if eig[1] > 0 else 0
        try:
            inside = ratio >= 0.35 and ConvexHull(coords).volume >= 0.15
        except QhullError:
            inside = False
    if inside:
        rows.append(("inside", float(center[0]), float(center[1])))
        for i in np.unique(np.linspace(0, len(coords) - 1, min(8, len(coords)), dtype=int)):
            p = 0.55 * center + 0.45 * coords[i]
            rows.append(("inside", float(p[0]), float(p[1])))
    result = pd.DataFrame(rows, columns=["region", "x", "y"])
    result["point"] = result.groupby("region").cumcount() + 1
    return result, inside


@st.cache_data(show_spinner=False)
def load_cluster(path, sensor_records, spike_q, max_station_km):
    records = list(sensor_records)
    count = 0
    with sqlite3.connect(path) as con:
        for sensor, station, distance, lat, lon, x, y in records:
            count += con.execute("SELECT COUNT(*) FROM pm WHERE sensor=?", (sensor,)).fetchone()[0]
        if count > MAX_SENSOR_HOURS:
            return None, None, count
        parts, coverage = [], []
        for sensor, station, distance, lat, lon, x, y in records:
            station_used = station if distance <= max_station_km else "__NO_STATION__"
            d = pd.read_sql_query("""SELECT p.hour,p.total/p.n AS pm,w.ss,w.cc,w.n AS wn,w.fs,w.fn
                  FROM pm p LEFT JOIN wind w ON p.hour=w.hour AND w.station=? WHERE p.sensor=? ORDER BY p.hour""",
                  con, params=(station_used, sensor))
            if d.empty:
                continue
            valid = d.wn.notna() & (np.hypot(d.ss.fillna(0), d.cc.fillna(0)) / d.wn.fillna(1) >= 0.1)
            d["direction"] = np.where(valid, (np.degrees(np.arctan2(d.ss, d.cc)) % 360), np.nan)
            d["fh_raw"] = np.where(d.fn.fillna(0) > 0, d.fs / d.fn, np.nan)
            threshold = float(d.pm.quantile(spike_q))
            d["spike"] = d.pm > threshold
            d["sensor"], d["station"] = sensor, station
            d["lat"], d["lon"], d["x"], d["y"] = lat, lon, x, y
            d["time"] = pd.to_datetime(d.hour, unit="h", utc=True)
            status = "station too far" if distance > max_station_km else ("no matched wind" if not valid.any() else "matched")
            coverage.append({"sensor": sensor, "station": station, "distance_km": distance, "PM hours": len(d), "matched wind hours": int(valid.sum()), "spike threshold": threshold, "matched spikes": int((d.spike & valid).sum()), "status": status})
            parts.append(d)
    if not parts:
        return pd.DataFrame(), pd.DataFrame(coverage), count
    return pd.concat(parts, ignore_index=True), pd.DataFrame(coverage), count


def compatibility(dx, dy, dd, width0, growth):
    a = np.deg2rad(np.asarray(dd, dtype=float))
    ux, uy = -np.sin(a), -np.cos(a)  # DD is FROM; arrows point TOWARD.
    down = dx * ux + dy * uy
    cross = -dx * uy + dy * ux
    width = width0 + growth * np.maximum(down, 0)
    return np.where(down > 0, np.exp(-0.5 * (cross / width) ** 2), 0.0)


@st.cache_data(show_spinner=False)
def score_hypotheses(data, candidates, width0, growth, min_hours, min_weight):
    sums = np.zeros(len(candidates))
    counts = np.zeros(len(candidates), dtype=int)
    supports = np.zeros(len(candidates))
    for sensor, group in data.groupby("sensor", sort=False):
        d = group.dropna(subset=["direction"])
        if len(group) < 30 or len(d) < min_hours or not d.spike.any():
            continue
        dd, spikes = d.direction.to_numpy(), d.spike.to_numpy(dtype=float)
        sx, sy = float(d.x.iloc[0]), float(d.y.iloc[0])
        for j, row in enumerate(candidates.itertuples(index=False)):
            w = compatibility(sx - row.x, sy - row.y, dd, width0, growth)
            yes, no = float(w.sum()), float((1 - w).sum())
            if yes < min_weight or no < min_weight:
                continue
            sums[j] += np.dot(w, spikes) / yes - np.dot(1 - w, spikes) / no
            counts[j] += 1
            supports[j] += np.dot(w, spikes)
    result = candidates.copy()
    result["sensors"] = counts
    result["score"] = np.where(counts >= 3, sums / np.maximum(counts, 1), np.nan)
    result["weighted spike sensor-hours"] = supports
    regions = []
    for region, g in result.groupby("region", sort=False):
        valid = g.dropna(subset=["score"])
        sufficient = len(valid) >= int(np.ceil(len(g) / 2))
        regions.append({"region": region, "score": float(valid.score.mean()) if sufficient else np.nan,
            "scored points": len(valid), "tested points": len(g),
            "min sensors": int(valid.sensors.min()) if len(valid) else 0})
    return result, pd.DataFrame(regions).sort_values("score", ascending=False, na_position="last")


def hour_text(h):
    return "No data" if h is None else pd.to_datetime(int(h), unit="h", utc=True).strftime("%Y-%m-%d %H:%M UTC")


def build_map(snapshot, points, region, source, lat0, lon0, width0, growth, vmax, street):
    d = snapshot.copy()
    d["compatibility"] = compatibility(d.x - source.x, d.y - source.y, d.direction, width0, growth)
    d.loc[d.direction.isna(), "compatibility"] = np.nan
    d["label"] = d.apply(lambda r: f"Sensor: {r.sensor}<br>PM2.5: {r.pm:.2f}<br>Spike: {'yes' if r.spike else 'no'}<br>Wind FROM: {r.direction:.0f}°<br>Compatibility: {r.compatibility:.2f}" if pd.notna(r.direction) else f"Sensor: {r.sensor}<br>PM2.5: {r.pm:.2f}<br>No matched wind", axis=1)
    plon, plat = lonlat(points[["x", "y"]].to_numpy(), lat0, lon0)
    slon, slat = lonlat(np.array([[source.x, source.y]]), lat0, lon0)
    # Display uses mean wind; scoring uses each sensor's own matched wind.
    wind_d = d.dropna(subset=["direction"])
    wx = -np.sin(np.deg2rad(wind_d.direction.to_numpy()))
    wy = -np.cos(np.deg2rad(wind_d.direction.to_numpy()))
    norm = np.hypot(wx.mean(), wy.mean()) if len(wind_d) else 0.0
    plume_lon = plume_lat = None
    if norm > 0.1:
        u = np.array([wx.mean(), wy.mean()]) / norm
        perp = np.array([-u[1], u[0]])
        start = np.array([source.x, source.y])
        length = min(10.0, max(2.0, float(np.linalg.norm(d[["x", "y"]].to_numpy() - start, axis=1).max()) + 0.5))
        end = start + length * u
        far_width = width0 + growth * length
        polygon = np.array([start - width0 * perp, start + width0 * perp, end + far_width * perp, end - far_width * perp, start - width0 * perp])
        plume_lon, plume_lat = lonlat(polygon, lat0, lon0)
    # Wind lines point TOWARD their tips, opposite the recorded DD direction.
    visible = wind_d.iloc[::max(1, int(np.ceil(len(wind_d) / 50)))]
    line_lon, line_lat, tips_lon, tips_lat = [], [], [], []
    for r in visible.itertuples():
        a = np.deg2rad(r.direction)
        tip = np.array([[r.x - 0.35 * np.sin(a), r.y - 0.35 * np.cos(a)]])
        tx, ty = lonlat(tip, lat0, lon0)
        line_lon.extend([r.lon, float(tx[0]), None])
        line_lat.extend([r.lat, float(ty[0]), None])
        tips_lon.append(float(tx[0]))
        tips_lat.append(float(ty[0]))
    if street:
        fig = go.Figure()
        if plume_lon is not None:
            fig.add_trace(go.Scattermapbox(lon=plume_lon, lat=plume_lat, mode="lines", fill="toself", fillcolor="rgba(124,58,237,0.13)", line=dict(color="rgba(124,58,237,0.5)", width=1), name="Illustrative plume"))
        if line_lon:
            fig.add_trace(go.Scattermapbox(lon=line_lon, lat=line_lat, mode="lines", line=dict(color="#0f766e", width=2), name="Wind toward tip"))
            fig.add_trace(go.Scattermapbox(lon=tips_lon, lat=tips_lat, mode="markers", marker=dict(size=5, color="#0f766e"), name="Wind tips"))
        fig.add_trace(go.Scattermapbox(lon=d.lon, lat=d.lat, mode="markers", text=d.label, hoverinfo="text", name="PM sensors", marker=dict(size=13, color=d.pm, colorscale=PALETTE, cmin=0, cmax=vmax, showscale=True, colorbar=dict(title="PM2.5"))))
        fig.add_trace(go.Scattermapbox(lon=plon, lat=plat, mode="markers", name=f"{region} points", text=[f"{region}: point {i}" for i in points.point], hoverinfo="text", marker=dict(size=10, color="#7c3aed", opacity=.65)))
        fig.add_trace(go.Scattermapbox(lon=slon, lat=slat, mode="markers", name="Selected point", marker=dict(size=17, color="#111827")))
        fig.update_layout(mapbox=dict(style="open-street-map", center=dict(lat=float(d.lat.mean()), lon=float(d.lon.mean())), zoom=10), height=560, margin=dict(l=5, r=5, t=10, b=5), legend=dict(orientation="h"))
    else:
        fig = go.Figure()
        if plume_lon is not None:
            fig.add_trace(go.Scatter(x=plume_lon, y=plume_lat, mode="lines", fill="toself", fillcolor="rgba(124,58,237,0.13)", line=dict(color="rgba(124,58,237,0.5)", width=1), name="Illustrative plume"))
        if line_lon:
            fig.add_trace(go.Scatter(x=line_lon, y=line_lat, mode="lines", line=dict(color="#0f766e", width=2), name="Wind toward tip"))
            fig.add_trace(go.Scatter(x=tips_lon, y=tips_lat, mode="markers", marker=dict(size=5, color="#0f766e"), name="Wind tips"))
        fig.add_trace(go.Scatter(x=d.lon, y=d.lat, mode="markers", text=d.label, hoverinfo="text", name="PM sensors", marker=dict(size=12, color=d.pm, colorscale=PALETTE, cmin=0, cmax=vmax, showscale=True, colorbar=dict(title="PM2.5"))))
        fig.add_trace(go.Scatter(x=plon, y=plat, mode="markers", name=f"{region} points", text=[f"{region}: point {i}" for i in points.point], hoverinfo="text", marker=dict(size=10, color="#7c3aed", opacity=.65)))
        fig.add_trace(go.Scatter(x=slon, y=slat, mode="markers", name="Selected point", marker=dict(size=16, color="#111827", symbol="x")))
        fig.update_layout(height=560, margin=dict(l=10, r=10, t=10, b=10), xaxis_title="Longitude", yaxis_title="Latitude", legend=dict(orientation="h"), xaxis=dict(scaleanchor="y", scaleratio=np.cos(np.deg2rad(lat0))))
    return fig, d


